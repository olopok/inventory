<!DOCTYPE html>
<html lang="en">
  <%- include ('./partials/head') %>
</html>
<body>
  <h1 class="pageTitle">Shop Inventory</h1>
  <main>
    <aside class="left">
      <span><strong>Categories</strong></span>
      <table>
        <tr>
          <th>ID</th>
          <th>CATEGORY NAME</th>
        </tr>
        <% categories.forEach(category => { %>
        <tr>
          <td><%= category.id %></td>
          <td><%= category.name %></td>
        </tr>
        <% }) %>
      </table>
      <button
        type="button"
        class="btn"
        command="show-modal"
        commandfor="cat-dialog"
      >
        ADD
      </button>
      <dialog id="cat-dialog" closedby="any">
        <form action="/editdata" method="post">
          <label for="addcat">Category Name</label>
          <input type="text" name="addcat" id="addcat" />
          <button type="submit" class="btn">Save</button>
        </form>
        <button type="button" commandfor="cat-dialog" command="close" class="btn">
          Cancel
        </button>
      </dialog>
    </aside>
    <section class="center">
      <span><strong>Products</strong></span>
      <table>
        <tr>
          <th>ID</th>
          <th>PRODUCT NAME</th>
          <th>QUANTITY</th>
          <th>CATEGORY_ID</th>
        </tr>
        <% products.forEach(product => { %>
        <tr>
          <td><%= product.id %></td>
          <td><%= product.name %></td>
          <td><%= product.quantity %></td>
          <td><%= product.category_id %></td>
        </tr>
        <% }) %>
      </table>
      <button type="button" class="btn">ADD</button>
    </section>
    <menu></menu>
  </main>
</body>
