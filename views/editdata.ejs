<!DOCTYPE html>
<html lang="en">
  <%- include ('./partials/head') %>
</html>
<body>
  <h1 class="pageTitle">Shop Inventory</h1>
  <main>
    <aside class="left">
      <span><strong>Categories</strong></span>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>CATEGORY NAME</th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(category => { %>
          <tr>
            <td><%= category.id %></td>
            <td><%= category.name %></td>
            <td class="edit">
              <% if (category.name !== 'UNCATEGORISED') { %>
              <div class="inside-form">
                <button
                  command="show-modal"
                  commandfor="edit-dialog-<%= category.id %>"
                >
                  <img src="/static/square-pen.png" alt="edit" />
                </button>
                <dialog id="edit-dialog-<%= category.id %>" closedby="any">
                  <form action="/editdata/<%= category.id %>" method="post">
                    <label for="editcat">New Category Name:</label>
                    <input type="text" name="editcat" id="editcat" required />
                    <button type="submit" class="btn">Save</button>
                  </form>
                  <button
                    type="button"
                    commandfor="edit-dialog-<%= category.id %>"
                    command="close"
                    class="btn"
                  >
                    Cancel
                  </button>
                </dialog>
                <form action="/delete/<%= category.id %>" method="post">
                  <button type="submit">
                    <img src="/static/trash.png" alt="delete" />
                  </button>
                </form>
              </div>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <button
        type="button"
        class="btn"
        command="show-modal"
        commandfor="cat-dialog"
      >
        ADD
      </button>
      <dialog id="cat-dialog" closedby="any">
        <form action="/editdata" method="post">
          <label for="addcat">Category Name</label>
          <input type="text" name="addcat" id="addcat" />
          <button type="submit" class="btn">Save</button>
        </form>
        <button
          type="button"
          commandfor="cat-dialog"
          command="close"
          class="btn"
        >
          Cancel
        </button>
      </dialog>
    </aside>
    <section class="center">
      <span><strong>Products</strong></span>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>PRODUCT NAME</th>
            <th>QUANTITY</th>
            <th>CATEGORY_ID</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(product => { %>
          <tr>
            <td><%= product.id %></td>
            <td><%= product.name %></td>
            <td><%= product.quantity %></td>
            <td><%= product.category_id %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <button
        type="button"
        class="btn"
        command="show-modal"
        commandfor="product-dialog"
      >
        ADD
      </button>
      <dialog id="product-dialog" closedby="any">
        <form action="/editdata/products" method="post">
          <label for="addproduct">Product Name</label>
          <input type="text" name="addproduct" id="addproduct" />
          <label for="quantity">Quantity</label>
          <input type="text" name="quantity" id="quantity" />
          <label for="productCategoryId">Category</label>
          <select name="productCategoryId" id="productCategoryId" required>
            <% categories.forEach(category => { %>
            <option value="<%= category.id %>">
              <%= category.name %>
            </option>
            <% }) %>
          </select>
          <button type="submit" class="btn">Save</button>
        </form>
        <button
          type="button"
          commandfor="product-dialog"
          command="close"
          class="btn"
        >
          Cancel
        </button>
      </dialog>
    </section>
    <menu></menu>
  </main>
</body>
