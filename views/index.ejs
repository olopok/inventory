<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head') %>
  <body>
    <h1 class="pageTitle">Shop Inventory</h1>
    <main class="main-container">
      <form action="/categories" method="get" class="categories-card">
        <button type="submit">Shows Categories</button>
      </form>
      <form action="/products" method="get" class="products-card">
        <button type="submit">Shows Products</button>
      </form>
      <div class="edit-card">
        <a href="/editdata">Edit Inventory</a>
      </div>
    </main>
    <% if (categories&&categories.length>0){ %>
    <h3 class="categories-list-title"><strong>Categories List</strong></h3>
    <section class="list-container">
      <% categories.forEach(element => {%>
      <form
        action="/category/<%= element.id %>"
        method="get"
        class="category-list-card"
      >
        <button type="submit">
          <strong><%= element.name %>: </strong>
          <%= element.items_quantity %>
          Items
        </button>
      </form>
      <% }); %>
    </section>
    <%}%>
    <% if(items && items.length > 0) {%>
    <h3 class="products-list-title">Items List</h3>
    <table class="items-list-container">
      <tr>
        <th>ITEM</th>
        <th>QUANTITY</th>
      </tr>
      <% items.forEach(item => { %>
      <tr>
        <td><%= item.name %></td>
        <td class="quantity"><%= item.quantity %></td>
      </tr>
      <% }) %>
    </table>
    <% } %>
    <% if(products && products.length > 0) {%>
    <h3 class="products-list-title">Products List</h3>
    <table class="products-list-container">
      <tr>
        <th>ID</th>
        <th>PRODUCT</th>
        <th>QUANTITY</th>
        <th>CATEGORY ID</th>
      </tr>
      <% products.forEach(product => { %>
      <tr>
        <td><%= product.id %></td>
        <td><%= product.name %></td>
        <td class="quantity"><%= product.quantity %></td>
        <td><%= product.category_id %></td>
      </tr>
      <% }) %>
    </table>
    <% } %>
  </body>
</html>
